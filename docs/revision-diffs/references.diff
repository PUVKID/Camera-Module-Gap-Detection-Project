+def order_points(pts):
+    """
+    4개의 꼭짓점을 좌상, 우상, 우하, 좌하 순서로 정렬하는 함수 (PCA 없이 중심점을 기준으로 정렬)
+    """
+    # 1️⃣ 4개 점의 중심점(center) 계산
+    center = np.mean(pts, axis=0)
+    # 2️⃣ 좌우를 나눔 (x 좌표 기준)
+    left_pts = pts[pts[:, 0] < center[0]]  # 중심보다 왼쪽
+    right_pts = pts[pts[:, 0] >= center[0]]  # 중심보다 오른쪽
+    # 3️⃣ 좌측(L) 그룹 정렬
+    left_pts = sorted(left_pts, key=lambda p: p[1])  # y값 기준 정렬 (위 → 아래)
+    top_left, bottom_left = left_pts  # 위쪽이 좌상, 아래쪽이 좌하
+    # 4️⃣ 우측(R) 그룹 정렬
+    right_pts = sorted(right_pts, key=lambda p: p[1])  # y값 기준 정렬 (위 → 아래)
+    top_right, bottom_right = right_pts  # 위쪽이 우상, 아래쪽이 우하
+    # 5️⃣ 최종 정렬된 좌표 반환 (좌상, 우상, 우하, 좌하)
+    return np.array([top_left, top_right, bottom_right, bottom_left], dtype=np.float32)
+def find_boundary_points(mask, min_area=100, epsilon_factor=0.02):
+    """
+    마스크에서 4개의 코너 포인트를 찾고 좌상단(left_top)과 우상단(right_top)을 반환
+    """
+    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+    if not contours:
+        return None, None  # 컨투어가 없으면 None 반환
+    
+    largest_contour = max(contours, key=cv2.contourArea)
