+    if cv2.contourArea(largest_contour) < min_area:
+        return None, None  # 너무 작은 컨투어는 무시
+    
+    epsilon = epsilon_factor * cv2.arcLength(largest_contour, True)
+    approx = cv2.approxPolyDP(largest_contour, epsilon, True)
+    if len(approx) > 4:
